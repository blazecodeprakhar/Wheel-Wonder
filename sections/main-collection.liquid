<section class="section-main-collection">
  <div class="container">
    <div class="collection-hero-banner">
      <h1 class="collection-page-title">{{ collection.title | default: "Hot Wheels 1:64 Vault" }}</h1>
      <p class="collection-page-desc">{{ collection.description | default: "Browse the complete Wheel&Wonder 1:64 Hot Wheels collection. Factory-sealed Mattel blisters across JDM, Exotics, Muscle & Track Stars — every single car at flat ₹179 MRP." }}</p>
    </div>

    {%- liquid
      assign count = collection.products_count
      if count == blank or count == 0
        if collection.products.size > 0
          assign count = collection.products.size
        else
          assign count = 23
        endif
      endif
    -%}

    <div class="collection-toolbar">
      <span class="collection-count">{{ count }} Collector Castings • Flat ₹179 Each</span>
      <div class="collection-sort">
        <label for="SortBy">Sort by:</label>
        <select id="SortBy" class="sort-select">
          <option value="featured">Featured Drop</option>
          <option value="title-asc">Name: A to Z</option>
          <option value="title-desc">Name: Z to A</option>
        </select>
      </div>
    </div>

    <div class="products-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; width: 100%;">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-card', demo_id: 'hw-02', demo_order: 1, demo_category: 'jdm', demo_title: 'Hot Wheels Toyota Supra (MK4 A80)', demo_series: 'Then & Now', demo_price: 17900, demo_compare: 0, demo_badge: 'JDM GRAIL', demo_image: 'hw-car-02.jpg' %}
        {% render 'product-card', demo_id: 'hw-03', demo_order: 3, demo_category: 'jdm', demo_title: "Hot Wheels '99 Honda Civic Type R (EK9)", demo_series: 'HW J-Imports', demo_price: 17900, demo_compare: 0, demo_badge: 'VTEC LEGEND', demo_image: 'hw-car-03.jpg' %}
        {% render 'product-card', demo_id: 'hw-04', demo_order: 4, demo_category: 'jdm', demo_title: 'Hot Wheels Mazda RX-7 (FD3S)', demo_series: 'HW Drift', demo_price: 17900, demo_compare: 0, demo_badge: 'ROTARY DRIFT', demo_image: 'hw-car-04.jpg' %}
        {% render 'product-card', demo_id: 'hw-05', demo_order: 5, demo_category: 'jdm', demo_title: 'Hot Wheels Custom Datsun 240Z (#23)', demo_series: 'Nightburnerz', demo_price: 17900, demo_compare: 0, demo_badge: 'CLASSIC JDM', demo_image: 'hw-car-05.jpg' %}
        {% render 'product-card', demo_id: 'hw-06', demo_order: 6, demo_category: 'jdm', demo_title: 'Hot Wheels Subaru WRX STI Rally', demo_series: 'HW Turbo', demo_price: 17900, demo_compare: 0, demo_badge: 'AWD TURBO', demo_image: 'hw-car-06.jpg' %}
        {% render 'product-card', demo_id: 'hw-07', demo_order: 7, demo_category: 'exotics', demo_title: 'Hot Wheels Porsche 911 GT3 (992)', demo_series: 'HW Exotics', demo_price: 17900, demo_compare: 0, demo_badge: 'HW EXOTICS', demo_image: 'hw-car-07.jpg' %}
        {% render 'product-card', demo_id: 'hw-08', demo_order: 8, demo_category: 'exotics', demo_title: 'Hot Wheels Lamborghini Huracán LP 610-4', demo_series: 'HW Exotics', demo_price: 17900, demo_compare: 0, demo_badge: 'V10 EXOTIC', demo_image: 'hw-car-08.jpg' %}
        {% render 'product-card', demo_id: 'hw-09', demo_order: 9, demo_category: 'exotics', demo_title: 'Hot Wheels McLaren P1 Hypercar', demo_series: 'HW Exotics', demo_price: 17900, demo_compare: 0, demo_badge: 'HYPERCAR', demo_image: 'hw-car-09.jpg' %}
        {% render 'product-card', demo_id: 'hw-10', demo_order: 10, demo_category: 'exotics', demo_title: 'Hot Wheels Koenigsegg Jesko Absolut', demo_series: 'HW Exotics', demo_price: 17900, demo_compare: 0, demo_badge: 'SPEED KING', demo_image: 'hw-car-10.jpg' %}
        {% render 'product-card', demo_id: 'hw-11', demo_order: 11, demo_category: 'exotics', demo_title: "Hot Wheels '16 Bugatti Chiron", demo_series: 'HW Exotics', demo_price: 17900, demo_compare: 0, demo_badge: 'W16 QUAD', demo_image: 'hw-car-11.jpg' %}
