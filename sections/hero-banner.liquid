<section class="hero-section vimi-desktop-hero" id="hero-banner">
  <div class="hero-bg-watermark">HOT WHEELS 1:64</div>
  <div class="container hero-container">
    
    <!-- Hero Left: Typography & Brand Value -->
    <div class="hero-content">
      <div class="hero-badge-row">
        <div class="hero-tag-badge">
          <span class="badge-dot"></span>
          <span>2026 CASE DROP • SEALED BLISTERS</span>
        </div>
        <span class="crazzzy-pill">🏁 EVERY CAR FLAT ₹179</span>
      </div>

      <h1 class="hero-title">
        1:64 LEGENDS.<br>
        MATTEL SEALED.<br>
        <span class="text-gradient">FLAT ₹179 MRP.</span>
      </h1>

      <p class="hero-description">
        {{ section.settings.description | default: "India's dedicated Hot Wheels & 1:64 die-cast toy store. Factory-sealed JDM icons, Euro Exotics, American Muscle & Track Stars — zero scalper markups, always ₹179 per car." }}
      </p>

      <div class="hero-features-chips">
        <span class="chip">🏁 1:64 Die-Cast Metal</span>
        <span class="chip">💰 Every Car ₹179</span>
        <span class="chip">🚚 Free Delivery ₹499+</span>
        <span class="chip">🎁 Free Car ₹999+</span>
        <span class="chip">🔥 2 Free Cars ₹1,499+</span>
      </div>

      <div class="hero-cta-group">
        <a href="#featured-cars" class="btn btn--primary">
          <span>EXPLORE ALL 23 CARS</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <button 
          type="button" 
          class="btn btn--outline"
          id="HeroQuickBuyBtn"
          onclick="document.getElementById('HeroSlideQuickBuy').click();"
        >
          <span>⚡ QUICK BUY THIS CAR</span>
        </button>
      </div>

      <div class="hero-social-proof">
        <div class="proof-avatars">
          <div class="avatar-circle">H</div>
          <div class="avatar-circle">W</div>
          <div class="avatar-circle">6</div>
          <div class="avatar-circle">4</div>
        </div>
        <div class="proof-text">
          <strong>4.9 / 5 Rating • Collector Verified</strong>
          <span>Trusted by 12,000+ Hot Wheels collectors across India</span>
        </div>
      </div>
    </div>

    <!-- Hero Right: Dynamic Auto-Cycling Showcase Card -->
    <div class="hero-visual">
      <div class="hero-card-showcase" id="HeroShowcase">
        
        <div class="showcase-badge-row">
          <span class="showcase-badge" id="HeroBadgeText">JDM GRAIL #01</span>
          <div class="showcase-live-pill">
            <span class="live-dot"></span>
            <span>₹179 MRP</span>
          </div>
        </div>

        <!-- Auto-cycling Slides Stage -->
        <div class="hero-slider-stage" id="HeroSliderStage">
          <!-- Slide 1: Toyota Supra MK4 -->
          <div class="hero-slide active" data-index="0" data-title="Hot Wheels Toyota Supra (MK4 A80)" data-sub="Then &amp; Now Series • 1:64 Die-Cast • Mint Blister" data-price="179" data-compare="179" data-badge="JDM GRAIL #01" data-image="hw-car-02.jpg">
            <img src="{{ 'hw-car-02.jpg' | asset_url }}" alt="Hot Wheels Toyota Supra (MK4 A80)" class="hero-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-02.jpg'; vimiImgLoaded(this);">
          </div>
          <!-- Slide 2: Porsche 911 GT3 -->
          <div class="hero-slide" data-index="1" data-title="Hot Wheels Porsche 911 GT3 (992)" data-sub="HW Exotics • 1:64 Die-Cast • Factory Sealed" data-price="179" data-compare="179" data-badge="HW EXOTICS" data-image="hw-car-07.jpg">
            <img src="{{ 'hw-car-07.jpg' | asset_url }}" alt="Hot Wheels Porsche 911 GT3 (992)" class="hero-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-07.jpg'; vimiImgLoaded(this);">
          </div>
          <!-- Slide 3: Koenigsegg Jesko -->
          <div class="hero-slide" data-index="2" data-title="Hot Wheels Koenigsegg Jesko Absolut" data-sub="HW Exotics • Aerodynamic Carbon Look • 1:64" data-price="179" data-compare="179" data-badge="HYPERCAR" data-image="hw-car-10.jpg">
            <img src="{{ 'hw-car-10.jpg' | asset_url }}" alt="Hot Wheels Koenigsegg Jesko Absolut" class="hero-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-10.jpg'; vimiImgLoaded(this);">
          </div>
          <!-- Slide 4: Ford Mustang Boss 302 -->
          <div class="hero-slide" data-index="3" data-title="Hot Wheels '69 Ford Mustang Boss 302" data-sub="Muscle Mania • 1:64 Die-Cast • Mint Blister" data-price="179" data-compare="179" data-badge="MUSCLE MANIA" data-image="hw-car-13.jpg">
            <img src="{{ 'hw-car-13.jpg' | asset_url }}" alt="Hot Wheels '69 Ford Mustang Boss 302" class="hero-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-13.jpg'; vimiImgLoaded(this);">
          </div>
          <!-- Slide 5: Arkham Knight Batmobile -->
          <div class="hero-slide" data-index="4" data-title="Hot Wheels Batman Arkham Knight Batmobile" data-sub="Batman Series • 1:64 Die-Cast • Armored Chassis" data-price="179" data-compare="179" data-badge="BATMAN SERIES" data-image="hw-car-23.jpg">
            <img src="{{ 'hw-car-23.jpg' | asset_url }}" alt="Hot Wheels Batman Arkham Knight Batmobile" class="hero-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-23.jpg'; vimiImgLoaded(this);">
          </div>

          <button type="button" class="hero-stage-arrow hero-stage-arrow--prev" id="HeroStagePrev" aria-label="Previous car">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="hero-stage-arrow hero-stage-arrow--next" id="HeroStageNext" aria-label="Next car">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>

        <!-- Navigation Dots & Counter -->
        <div class="hero-slider-nav">
          <div class="hero-slider-dots">
            <button type="button" class="hero-dot active" data-slide="0" aria-label="Slide 1"><span class="hero-dot-fill"></span></button>
            <button type="button" class="hero-dot" data-slide="1" aria-label="Slide 2"><span class="hero-dot-fill"></span></button>
            <button type="button" class="hero-dot" data-slide="2" aria-label="Slide 3"><span class="hero-dot-fill"></span></button>
            <button type="button" class="hero-dot" data-slide="3" aria-label="Slide 4"><span class="hero-dot-fill"></span></button>
            <button type="button" class="hero-dot" data-slide="4" aria-label="Slide 5"><span class="hero-dot-fill"></span></button>
          </div>
          <div class="hero-slider-counter" id="HeroSliderCounter">01 / 05</div>
        </div>

        <!-- Dynamic Product Details for Active Slide -->
        <div class="showcase-details">
          <div class="showcase-row">
            <div>
              <h4 class="showcase-name" id="HeroTitle">Hot Wheels Toyota Supra (MK4 A80)</h4>
              <p class="showcase-sub" id="HeroSub">Then &amp; Now Series • 1:64 Die-Cast • Mint Blister</p>
            </div>
            <div class="showcase-price-box">
              <span class="showcase-curr" id="HeroPrice">₹179</span>
              <span class="showcase-orig" id="HeroCompare" style="text-decoration:none;">FLAT MRP</span>
            </div>
          </div>

          <div class="showcase-actions-grid">
            <button 
              type="button" 
              class="btn btn--primary open-buying-window"
              id="HeroSlideQuickBuy"
              data-product-title="Hot Wheels Toyota Supra (MK4 A80)"
              data-product-price="179"
              data-product-compare="179"
              data-product-badge="JDM GRAIL #01"
              data-product-image="hw-car-02.jpg"
            >
              ⚡ Quick Buy Window
            </button>

            <button 
              type="button" 
              class="btn btn--secondary btn-quick-add"
              id="HeroSlideAddBag"
              data-product-title="Hot Wheels Toyota Supra (MK4 A80)"
              data-product-price="179"
              data-product-image="hw-car-02.jpg"
            >
              + Add to Bag
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- =========================================================
     MOBILE HERO (phones only, max-width: 767px)
     ========================================================= -->
<section class="vimi-m-hero" id="vimiMobileHero">
  <div class="m-marquee"><div>
    <span>Free Delivery Over ₹499</span><span>Order ₹999+ = 1 Free Car</span><span>Order ₹1,499+ = 2 Free Cars</span><span>Every Car ₹179</span>
    <span>Free Delivery Over ₹499</span><span>Order ₹999+ = 1 Free Car</span><span>Order ₹1,499+ = 2 Free Cars</span><span>Every Car ₹179</span>
  </div></div>

  <div class="m-pills">
    <span class="m-pill">2026 Case Drop • Sealed</span>
    <span class="m-pill hot">🏁 Flat ₹179 MRP</span>
  </div>

  <h1 class="m-h1"><em>1:64</em> Diecast Legends.<br>Hot Wheels.<br>Flat ₹179.</h1>
  <p class="m-sub">JDM tuners, Euro supercars, American muscle &amp; track stars. Factory-sealed Mattel blisters.</p>

  <div class="m-chips">
    <span class="m-chip">💰 Flat ₹179</span>
    <span class="m-chip">🚚 Free Del ₹499+</span>
    <span class="m-chip">🎁 1 Free Car ₹999+</span>
    <span class="m-chip">🔥 2 Free Cars ₹1,499+</span>
  </div>

  <div class="m-card">
    <div class="m-tag">MAINLINE DROP #01</div>
    <div class="m-badge">₹179</div>
    <div class="m-slides" id="mSlides">
      <div class="m-slide" style="background-image: url('{{ 'hw-car-02.jpg' | asset_url }}');" data-title="Hot Wheels Toyota Supra (MK4 A80)" data-meta="Then & Now • 1:64 Die-Cast • Mint Card" data-price="₹179" data-compare="" data-img="hw-car-02.jpg" data-raw-price="179" data-raw-compare="179">
        <img src="{{ 'hw-car-02.jpg' | asset_url }}" alt="Hot Wheels Toyota Supra (MK4 A80)" class="m-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-02.jpg'; vimiImgLoaded(this);">
      </div>
      <div class="m-slide" style="background-image: url('{{ 'hw-car-07.jpg' | asset_url }}');" data-title="Hot Wheels Porsche 911 GT3 (992)" data-meta="HW Exotics • 1:64 Die-Cast • Sealed" data-price="₹179" data-compare="" data-img="hw-car-07.jpg" data-raw-price="179" data-raw-compare="179">
        <img src="{{ 'hw-car-07.jpg' | asset_url }}" alt="Hot Wheels Porsche 911 GT3 (992)" class="m-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-07.jpg'; vimiImgLoaded(this);">
      </div>
      <div class="m-slide" style="background-image: url('{{ 'hw-car-10.jpg' | asset_url }}');" data-title="Hot Wheels Koenigsegg Jesko" data-meta="HW Exotics • Hypercar • 1:64 Metal" data-price="₹179" data-compare="" data-img="hw-car-10.jpg" data-raw-price="179" data-raw-compare="179">
        <img src="{{ 'hw-car-10.jpg' | asset_url }}" alt="Hot Wheels Koenigsegg Jesko" class="m-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-10.jpg'; vimiImgLoaded(this);">
      </div>
      <div class="m-slide" style="background-image: url('{{ 'hw-car-13.jpg' | asset_url }}');" data-title="Hot Wheels '69 Ford Mustang Boss 302" data-meta="Muscle Mania • 1:64 Die-Cast" data-price="₹179" data-compare="" data-img="hw-car-13.jpg" data-raw-price="179" data-raw-compare="179">
        <img src="{{ 'hw-car-13.jpg' | asset_url }}" alt="Hot Wheels '69 Ford Mustang Boss 302" class="m-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-13.jpg'; vimiImgLoaded(this);">
      </div>
      <div class="m-slide" style="background-image: url('{{ 'hw-car-23.jpg' | asset_url }}');" data-title="Hot Wheels Batman Arkham Knight Batmobile" data-meta="Batman Series • 1:64 Die-Cast" data-price="₹179" data-compare="" data-img="hw-car-23.jpg" data-raw-price="179" data-raw-compare="179">
        <img src="{{ 'hw-car-23.jpg' | asset_url }}" alt="Hot Wheels Batman Arkham Knight Batmobile" class="m-slide-img" onload="vimiImgLoaded(this);" onerror="this.src='./assets/hw-car-23.jpg'; vimiImgLoaded(this);">
      </div>
    </div>
    <div class="m-dots" id="mDots"><i class="on"></i><i></i><i></i><i></i><i></i></div>
    <div class="m-info">
      <div>
        <div class="m-name" id="mName">Hot Wheels Toyota Supra (MK4 A80)</div>
        <div class="m-meta" id="mMeta">Then &amp; Now • 1:64 Die-Cast • Mint Card</div>
      </div>
      <div class="m-price" id="mPrice">₹179</div>
    </div>
  </div>

  <div class="m-rating"><span>★★★★★</span><span><b>4.9/5</b> · 12,000+ collectors across India</span></div>

  <div class="m-cta">
    <button type="button" class="m-btn btn-quick-add" id="MobileHeroAddBag" data-product-title="Hot Wheels Toyota Supra (MK4 A80)" data-product-price="179" data-product-image="hw-car-02.jpg">+ Add (₹179)</button>
    <button type="button" class="m-btn primary open-buying-window" id="MobileHeroQuickBuy" data-product-title="Hot Wheels Toyota Supra (MK4 A80)" data-product-price="179" data-product-compare="179" data-product-badge="JDM GRAIL" data-product-image="hw-car-02.jpg">⚡ Quick Buy</button>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "1:64 DIECAST LEGENDS. FLAT ₹179."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "India's dedicated Hot Wheels & 1:64 die-cast toy store. Factory-sealed Mattel mainlines across JDM, Exotics, Muscle & Track Stars — every single car at ₹179 MRP."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
