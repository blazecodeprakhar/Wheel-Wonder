<section class="section-brand-story" id="brand-story">
  <div class="container">
    <div class="brand-story-grid">
      
      <div class="story-content">
        <span class="story-tag">COLLECTOR MANIFESTO</span>
        <h2 class="story-heading">
          BUILT FOR REAL COLLECTORS.<br>
          ZERO SCALPER MARKUPS.
        </h2>
        <div class="story-text">
          <p>
            <strong>WHEEL&WONDER</strong> was born out of frustration with scalped Hot Wheels prices and bent blister cards shipped in flimsy plastic mailers.
          </p>
          <p>
            Every 1:64 mainline casting in our vault — from <strong>Toyota Supra MK4</strong> and <strong>Porsche 911 GT3</strong> to <strong>Twin Mill</strong> and <strong>Batmobile</strong> — is priced strictly at <strong>₹179 MRP</strong>.
          </p>
          <p>
            Pick the exact car you want, get it packed in rigid 5-ply corrugated armor, and enjoy fast Pan-India delivery with Cash on Delivery or UPI.
          </p>
        </div>

        <div class="story-metrics">
          <div class="metric-item">
            <span class="metric-num">₹179</span>
            <span class="metric-label">Flat Price Per Car</span>
          </div>
          <div class="metric-item">
            <span class="metric-num">1:64</span>
            <span class="metric-label">ZAMAC Die-Cast</span>
          </div>
          <div class="metric-item">
            <span class="metric-num">100%</span>
            <span class="metric-label">Mattel Sealed</span>
          </div>
        </div>
      </div>

      <div class="story-visual">
        <div class="story-card">
          <div class="story-card-inner">
            <div class="story-badge">MINT CARD GUARANTEE</div>
            <div class="fabric-macro-visual">
              <svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg" class="fabric-svg">
                <rect width="320" height="220" rx="12" fill="#111111"/>
                <pattern id="trackGrid" width="24" height="24" patternUnits="userSpaceOnUse">
                  <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#1f1f1f" stroke-width="1"/>
                </pattern>
                <rect width="320" height="220" fill="url(#trackGrid)"/>
                <circle cx="160" cy="95" r="52" stroke="#f59e0b" stroke-width="2" stroke-dasharray="6 4" fill="none"/>
                <circle cx="160" cy="95" r="34" stroke="#ef4444" stroke-width="3" fill="#090909"/>
                <polygon points="158,72 172,72 162,92 176,92 152,118 158,97 146,97" fill="#ffffff"/>
                <text x="160" y="170" text-anchor="middle" fill="#ffffff" font-family="'Syne', sans-serif" font-weight="800" font-size="13" letter-spacing="2">WHEEL&WONDER 1:64</text>
                <text x="160" y="190" text-anchor="middle" fill="#f59e0b" font-family="sans-serif" font-weight="700" font-size="10" letter-spacing="1.5">FLAT ₹179 • ZERO BEND GUARANTEE</text>
              </svg>
            </div>
            <div class="story-quote">
              <p>"Every collector deserves mint cards at honest ₹179 MRP — never ₹600+ reseller tax."</p>
              <span>— WHEEL&WONDER Team, India</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
