<section class="section-anatomy" id="diecast-anatomy">
  <div class="container">
    <div class="anatomy-grid">
      
      <div class="anatomy-visual-card">
        <img 
          src="{{ 'hw-car-07.jpg' | asset_url }}" 
          alt="Hot Wheels 1:64 Diecast Anatomy" 
          class="anatomy-visual-img"
          onerror="this.src='./assets/hw-car-07.jpg';"
        >
        <div class="anatomy-badge-float">
          <div>
            <strong>1:64 MATTEL SPECIFICATION</strong>
            <span>ZAMAC DIE-CAST BODY • FACTORY SEALED BLISTER</span>
          </div>
          <button type="button" class="btn btn--primary open-buying-window" data-product-title="Hot Wheels Porsche 911 GT3 (992)" data-product-price="179" data-product-compare="179" data-product-badge="HW EXOTICS" data-product-image="hw-car-07.jpg" style="padding: 8px 14px; font-size: 0.72rem;">
            QUICK BUY ₹179
          </button>
        </div>
      </div>

      <div class="anatomy-content">
        <div class="anatomy-header">
          <span class="anatomy-tag">COLLECTOR SPECIFICATION</span>
          <h2 class="anatomy-title">ANATOMY OF A HOT WHEELS 1:64</h2>
        </div>

        <div class="anatomy-points">
          
          <div class="anatomy-point">
            <span class="point-index">01</span>
            <div>
              <h3 class="point-title">ZAMAC Die-Cast Metal Body</h3>
              <p class="point-desc">Precision-molded zinc alloy body shell with crisp panel lines, aerodynamic vents, and multi-pass authentic racing tampos.</p>
            </div>
          </div>

          <div class="anatomy-point">
            <span class="point-index">02</span>
            <div>
              <h3 class="point-title">High-Speed Low-Friction Axles</h3>
              <p class="point-desc">Nickel-plated steel axles paired with iconic Hot Wheels 5-spoke &amp; 10-spoke wheels engineered for orange track loops and smooth shelf display.</p>
            </div>
          </div>

          <div class="anatomy-point">
            <span class="point-index">03</span>
            <div>
              <h3 class="point-title">Factory-Sealed Mint Blister Card</h3>
              <p class="point-desc">Unopened Mattel blister packaging with collector card art, BIS safety mark, and flat ₹179 official Indian MRP.</p>
            </div>
          </div>

          <div class="anatomy-point">
            <span class="point-index">04</span>
            <div>
              <h3 class="point-title">5-Ply Corrugated Collector Shipping</h3>
              <p class="point-desc">Every order is individually bubble-wrapped and boxed in rigid 5-ply cardboard so card corners never bend in transit.</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Diecast Anatomy",
  "settings": [],
  "presets": [
    {
      "name": "Diecast Anatomy"
    }
  ]
}
{% endschema %}

