<section class="section-comparison" id="diecast-matrix">
  <div class="container text-center">
    
    <div style="max-width: 680px; margin: 0 auto;">
      <span style="font-size: 0.74rem; font-weight: 800; letter-spacing: 2px; color: #71717a; text-transform: uppercase;">WHY COLLECTORS CHOOSE WHEEL&WONDER</span>
      <h2 style="font-family: 'Syne', sans-serif; font-size: 2.3rem; font-weight: 800; margin-top: 8px; margin-bottom: 12px;">DIECAST COLLECTOR MATRIX</h2>
      <p style="color: #a1a1aa; font-size: 0.95rem;">How Wheel&Wonder compares to scalpers and random marketplace listings.</p>
    </div>

    <div class="comparison-table-wrap">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Collector Criteria</th>
            <th>Resellers / Scalpers</th>
            <th>Random E-Commerce</th>
            <th class="highlight-col">WHEEL&WONDER (OFFICIAL)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Price Per Mainline Car</strong></td>
            <td>₹399 – ₹999 (Inflated)</td>
            <td>₹249 – ₹349 + Random Assortment</td>
            <td class="highlight-col">Flat ₹179 Official MRP (Every Car)</td>
          </tr>
          <tr>
            <td><strong>Car Selection</strong></td>
            <td>Limited Stock</td>
            <td>Random / Assorted (No Choice)</td>
            <td class="highlight-col">Pick Exact Casting You Want</td>
          </tr>
          <tr>
            <td><strong>Blister Card Condition</strong></td>
            <td>Varies</td>
            <td>Often Bent in Poly-Bags</td>
            <td class="highlight-col">5-Ply Corrugated Box + Bubble Wrap</td>
          </tr>
          <tr>
            <td><strong>Authenticity</strong></td>
            <td>Unverified</td>
            <td>Mixed Third-Party Sellers</td>
            <td class="highlight-col">100% Sealed Mattel &amp; BIS Certified</td>
          </tr>
          <tr>
            <td><strong>Payment &amp; Shipping</strong></td>
            <td>Prepaid Only</td>
            <td>Extra Delivery Fees</td>
            <td class="highlight-col">COD + UPI • Free Shipping ₹999+</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

