<section class="section-features">
  <div class="container">
    <div class="features-grid">
      
      <div class="feature-item">
        <div class="feature-icon-box">
          {% render 'icon-truck' %}
        </div>
        <div class="feature-text">
          <h4 class="feature-title">Free Delivery Over ₹499</h4>
          <p class="feature-desc">Orders above ₹499 ship free across India in rigid 5-ply collector boxes.</p>
        </div>
      </div>

      <div class="feature-item">
        <div class="feature-icon-box">
          {% render 'icon-star' %}
        </div>
        <div class="feature-text">
          <h4 class="feature-title">1 Free Car Above ₹999</h4>
          <p class="feature-desc">Order above ₹999 &amp; get 1 bonus factory-sealed Hot Wheels car FREE!</p>
        </div>
      </div>

      <div class="feature-item">
        <div class="feature-icon-box">
          {% render 'icon-shield' %}
        </div>
        <div class="feature-text">
          <h4 class="feature-title">2 Free Cars Above ₹1,499</h4>
          <p class="feature-desc">Order above ₹1,499 &amp; unlock 2 FREE Hot Wheels cars + Free Delivery!</p>
        </div>
      </div>

      <div class="feature-item">
        <div class="feature-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
            <path d="M6 15h2"/>
          </svg>
        </div>
        <div class="feature-text">
          <h4 class="feature-title">Flat ₹179 Official MRP</h4>
          <p class="feature-desc">Zero scalper markups. 100% genuine Mattel 1:64 castings with COD &amp; UPI.</p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Banner",
  "settings": [],
  "presets": [
    {
      "name": "Features Banner"
    }
  ]
}
{% endschema %}
