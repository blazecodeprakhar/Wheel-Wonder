<footer class="site-footer">
  <div class="container footer-container">
    
    <div class="footer-top-grid">
      <div class="footer-col footer-col--brand">
        <a href="{{ routes.root_url }}" class="footer-logo">
          <img 
            src="{{ 'wheel-wonder-logo.png' | asset_url }}" 
            alt="Wheel&Wonder Hot Wheels Store" 
            class="footer-brand-logo-img"
            onerror="this.src='./assets/wheel-wonder-logo.png';"
            width="130"
            height="40"
          >
        </a>
        <p class="footer-about">
          India's dedicated 1:64 Hot Wheels &amp; die-cast toy store. Factory-sealed Mattel mainlines across JDM, Exotics, Muscle, and Track Legends — always at flat ₹179 MRP.
        </p>
        <div class="footer-contact">
          <p>📧 support@wheelandwonder.in</p>
          <p>📍 Collector-Safe Dispatch Pan-India</p>
          <p>⏰ Mon - Sat: 10:00 AM – 7:00 PM IST</p>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-col__title">Shop Die-Cast</h4>
        <ul class="footer-links">
          <li><a href="#featured-cars">All 23 Hot Wheels (₹179)</a></li>
          <li><a href="#featured-cars">HW J-Imports (JDM)</a></li>
          <li><a href="#featured-cars">HW Exotics &amp; Supercars</a></li>
          <li><a href="#featured-cars">Muscle Mania Legends</a></li>
          <li><a href="#featured-cars">Track Stars &amp; Batmobile</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col__title">Collector Care</h4>
        <ul class="footer-links">
          <li><a href="#">Track Your Parcel</a></li>
          <li><a href="#">Mint-Card Packing Policy</a></li>
          <li><a href="#">Pan-India Shipping (Free ₹999+)</a></li>
          <li><a href="#fit-finder">Bundle &amp; Pack Calculator</a></li>
          <li><a href="#">FAQs &amp; BIS Safety</a></li>
        </ul>
      </div>

      <div class="footer-col footer-col--newsletter">
        <h4 class="footer-col__title">Join Wheel&Wonder Club</h4>
        <p class="newsletter-sub">Get instant alerts when fresh Mattel cases (A–Q) land at <strong>flat ₹179 MRP</strong>.</p>
        <form class="footer-newsletter-form" onsubmit="event.preventDefault(); window.handleLoginSuccess('Welcome to Wheel&Wonder Club! You will get first ping on Case G restocks.');">
          <input type="email" placeholder="Enter your email or WhatsApp" required class="newsletter-input">
          <button type="submit" class="btn btn--primary newsletter-submit">JOIN</button>
        </form>
        <div class="newsletter-trust">
          <span>🔒 Zero spam. Unsubscribe anytime.</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom__left">
        <p>&copy; {{ 'now' | date: "%Y" }} <strong>WHEEL&WONDER</strong>. All rights reserved. Hot Wheels&reg; is a trademark of Mattel, Inc.</p>
      </div>

      <div class="footer-payments">
        <span class="pay-chip">UPI</span>
        <span class="pay-chip">GPay</span>
        <span class="pay-chip">PhonePe</span>
        <span class="pay-chip">Paytm</span>
        <span class="pay-chip">RuPay</span>
        <span class="pay-chip">Visa</span>
        <span class="pay-chip">Mastercard</span>
        <span class="pay-chip pay-chip--cod">COD Available</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
