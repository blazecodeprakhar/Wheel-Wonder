<header class="site-header" id="SiteHeader">
  <div class="header-container container">
    
    <!-- Mobile Hamburger Toggle -->
    <button type="button" class="header__icon-btn mobile-menu-toggle" aria-label="Toggle menu" id="MobileMenuBtn">
      {% render 'icon-menu' %}
    </button>

    <!-- Brand Logo -->
    <div class="header__logo-wrapper">
      <a href="{{ routes.root_url }}" class="header__logo">
        <img 
          src="{{ 'wheel-wonder-logo.png' | asset_url }}" 
          alt="Wheel&Wonder Hot Wheels Store" 
          class="header-brand-logo-img"
          onerror="this.src='./assets/wheel-wonder-logo.png';"
          width="140" 
          height="42"
        >
      </a>
    </div>

    <!-- Navigation Menu (Desktop) -->
    <nav class="header__nav" aria-label="Main Navigation">
      <ul class="header__menu-list">
        {%- if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="menu-item {% if link.active %}active{% endif %}">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="menu-item active"><a href="{{ routes.root_url }}">Home</a></li>
          <li class="menu-item"><a href="#featured-cars">All Cars (₹179)</a></li>
          <li class="menu-item"><a href="#featured-cars" onclick="document.querySelector('[data-filter=\'jdm\']')?.click();">JDM</a></li>
          <li class="menu-item"><a href="#featured-cars" onclick="document.querySelector('[data-filter=\'exotics\']')?.click();">Exotics</a></li>
          <li class="menu-item"><a href="#brand-story">Collector Guide</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Header Actions (Account/Login, Currency, Cart) -->
    <div class="header__actions">
      <div class="header__currency-badge" title="Store Currency: Indian Rupee">
        <span class="flag-icon">🇮🇳</span>
        <span class="currency-label">INR (₹)</span>
      </div>

      {%- if customer -%}
        <a href="{{ routes.account_url }}" class="header__icon-btn header__account-link" aria-label="My Account" title="Account: {{ customer.first_name | escape }}">
          {% render 'icon-user' %}
          <span class="header__account-name">{{ customer.first_name | default: 'Account' }}</span>
        </a>
      {%- else -%}
        <button type="button" class="header__icon-btn login-trigger" id="LoginTrigger" aria-label="Open Account Login" title="Sign In / Register">
          {% render 'icon-user' %}
        </button>
      {%- endif -%}

      <button type="button" class="header__icon-btn cart-trigger" id="CartTrigger" aria-label="Open cart">
        {% render 'icon-cart' %}
        <span class="header__cart-badge" id="HeaderCartBadge">0</span>
      </button>
    </div>

  </div>

  <!-- Mobile Slide Navigation -->
  <div class="mobile-nav-drawer" id="MobileNavDrawer">
    <div class="mobile-nav-overlay" id="MobileNavOverlay"></div>
    <div class="mobile-nav-content">
      <div class="mobile-nav-header">
        <img src="{{ 'wheel-wonder-logo.png' | asset_url }}" alt="Wheel&Wonder" style="height: 36px; width: auto;" onerror="this.src='./assets/wheel-wonder-logo.png';">
        <button type="button" class="mobile-nav-close" id="MobileNavClose">
          {% render 'icon-close' %}
        </button>
      </div>
      <ul class="mobile-nav-list">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="#featured-cars">All 23 Hot Wheels (₹179)</a></li>
        <li><a href="#featured-cars">JDM &amp; Street Tuners</a></li>
        <li><a href="#featured-cars">Exotics &amp; Supercars</a></li>
        <li><a href="#featured-cars">Muscle &amp; Track Stars</a></li>
        <li><a href="#brand-story">Our Story</a></li>
        {%- if customer -%}
          <li><a href="{{ routes.account_url }}" class="mobile-login-link">👤 Hi, {{ customer.first_name | default: 'Collector' | escape }} (My Account)</a></li>
          <li><a href="{{ routes.account_logout_url }}" class="mobile-logout-link" style="color: #888888; font-size: 0.85rem; padding-left: 20px;">Log Out</a></li>
        {%- else -%}
          <li><a href="#" class="mobile-login-link" id="MobileLoginLink">👤 Sign In / Create Account</a></li>
        {%- endif -%}
      </ul>
      <div class="mobile-nav-perks">
        <p>🏁 Every Hot Wheels Mainline Flat ₹179</p>
        <p>📦 Mint-Card Corrugated Shipping (Free ₹999+)</p>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
