<section class="section-main-product" id="MainProductSection">
  <div class="container product-page-container">
    
    <!-- Product Gallery -->
    <div class="product-gallery">
      <div class="gallery-main-image">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" id="ProductMainImage" class="main-img">
        {%- else -%}
          <img src="{{ 'hw-car-02.jpg' | asset_url }}" alt="Hot Wheels Toyota Supra (MK4 A80)" id="ProductMainImage" class="main-img" style="border-radius:16px;aspect-ratio:4/3;object-fit:cover;" onerror="this.src='./assets/hw-car-02.jpg';">
        {%- endif -%}
      </div>
    </div>

    <!-- Product Purchasing Info -->
    <div class="product-info-panel">
      
      <div class="product-info__badge-row">
        <span class="badge-tag">MATTEL 1:64 DIE-CAST METAL</span>
        <span class="badge-stock">⚡ Sealed Blister • Limited Case Stock</span>
      </div>

      <h1 class="product-info__title">
        {{ product.title | default: "Hot Wheels Toyota Supra (MK4 A80)" }}
      </h1>

      <div class="product-info__rating-row">
        <div class="stars">
          {% render 'icon-star' %}
          {% render 'icon-star' %}
          {% render 'icon-star' %}
          {% render 'icon-star' %}
          {% render 'icon-star' %}
        </div>
        <span class="rating-text">4.9 / 5.0 (240+ Verified Collector Reviews)</span>
      </div>

      <div class="product-info__price-box">
        {%- if product -%}
          {% render 'price', product: product %}
        {%- else -%}
          {% render 'price', price: 17900, compare_at_price: 0 %}
        {%- endif -%}
        <span class="tax-tag">Flat ₹179 Official Indian MRP (Inclusive of GST)</span>
      </div>

      <!-- Packaging Preference -->
      <div class="product-info__option-group">
        <div class="option-header">
          <label class="option-label">Select Blister Card Preference (Same ₹179 MRP):</label>
          <button type="button" class="btn-text-link" onclick="alert('WHEEL&WONDER PACKAGING GUIDE:\n\n• Long Card: Classic tall Hot Wheels card\n• Short Card: Compact mainline card\n• Mint Pick: Hand-inspected crease-free corners packed in 5-ply corrugated box.');">
            📦 Mint Card Guide
          </button>
        </div>
        <div class="size-swatches" id="SizeSwatches">
          <button type="button" class="size-btn active">Long Card</button>
          <button type="button" class="size-btn">Short Card</button>
          <button type="button" class="size-btn">Mint Collector Pick</button>
        </div>
      </div>

      <!-- Quantity + Add to Cart Form -->
      <form method="post" action="{{ routes.cart_add_url }}" class="product-form" id="AddToCartForm">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: '1' }}">
        
        <div class="form-action-row">
          <div class="quantity-input-box">
            <button type="button" class="qty-btn" id="QtyMinus">-</button>
            <input type="number" name="quantity" id="ProductQty" value="1" min="1" max="10" readonly>
            <button type="button" class="qty-btn" id="QtyPlus">+</button>
          </div>

          <button 
            type="button" 
            class="btn btn--primary btn--full btn-quick-add"
            data-product-title="{{ product.title | default: 'Hot Wheels Toyota Supra (MK4 A80)' | escape }}"
            data-product-price="{{ product.price | default: 17900 }}"
            data-product-image="hw-car-02.jpg"
          >
            ADD TO GARAGE BAG • ₹179
          </button>
        </div>

        <button type="button" class="btn btn--secondary btn--full" style="margin-top: 10px;" onclick="document.querySelector('.btn-quick-add').click();">
          ⚡ BUY NOW WITH CASH ON DELIVERY / UPI
        </button>
      </form>

      <!-- Indian Pincode Delivery Checker Widget -->
      <div class="pincode-checker-box">
        <label class="pincode-label">Check Delivery to your City/Pincode:</label>
        <div class="pincode-input-group">
          <input type="text" id="PincodeInput" placeholder="Enter 6-digit Pincode (e.g. 110001, 400001)" maxlength="6">
          <button type="button" class="btn btn--outline" id="PincodeCheckBtn">Check</button>
        </div>
        <p class="pincode-result" id="PincodeResult"></p>
      </div>

      <!-- Feature Badges -->
      <div class="product-perks-list">
        <div class="perk-row">
          <span class="perk-icon">📦</span>
          <div>
            <strong>Zero-Bend Collector Box Packing</strong>
            <span>Bubble-wrapped in rigid 5-ply corrugated boxes so cards arrive mint.</span>
          </div>
        </div>
        <div class="perk-row">
          <span class="perk-icon">💵</span>
          <div>
            <strong>Cash on Delivery (COD) &amp; UPI Supported</strong>
            <span>Pay at your doorstep or instantly via GPay, PhonePe, Paytm &amp; Cards.</span>
          </div>
        </div>
        <div class="perk-row">
          <span class="perk-icon">🚚</span>
          <div>
            <strong>Free Delivery ₹499+ • Bonus Free Cars!</strong>
            <span>Free Delivery over ₹499 • 1 Free Car above ₹999 • 2 Free Cars above ₹1,499.</span>
          </div>
        </div>
      </div>

      <!-- Accordion Specifications -->
      <div class="product-accordions">
        <details class="accordion-item" open>
          <summary class="accordion-summary">Die-Cast Specifications</summary>
          <div class="accordion-content">
            <ul>
              <li><strong>Scale:</strong> 1:64 Official Hot Wheels Mainline (~7 cm length)</li>
              <li><strong>Material:</strong> ZAMAC Die-Cast Metal body with high-detail plastic chassis</li>
              <li><strong>Packaging:</strong> Factory-sealed Mattel Blister Card (Age 3+)</li>
              <li><strong>Certification:</strong> BIS Certified Genuine Mattel Import</li>
              <li><strong>MRP:</strong> Flat ₹179 (Inclusive of all taxes)</li>
            </ul>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-summary">Shipping &amp; Card Protection</summary>
          <div class="accordion-content">
            <p>We never ship Hot Wheels in flimsy poly-bags. Every blister card is wrapped in protective bubble film and dispatched in a crush-resistant 5-ply corrugated carton.</p>
          </div>
        </details>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": []
}
{% endschema %}
