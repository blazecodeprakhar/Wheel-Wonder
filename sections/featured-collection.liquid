    <!-- Collection bottom CTA -->
    <div class="collection-footer-cta">
      <p class="bottom-guarantee">📦 <strong>All 23 Hot Wheels cars are flat ₹179 MRP and packed in 5-ply corrugated collector boxes</strong></p>
