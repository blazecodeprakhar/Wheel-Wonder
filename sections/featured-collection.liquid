{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "HOT WHEELS VAULT 2026"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "24 iconic 1:64 scale die-cast castings across JDM, Exotics, American Muscle & Track Legends. Every car flat ₹179."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 32,
      "step": 4,
      "default": 24,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
